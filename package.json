{
  "name": "tg-bot-builder",
  "version": "1.0.0",
  "description": "Visual Telegram bot constructor with two-way code-flowchart synchronization",
  "main": "src/main.js",
  "scripts": {
    "start": "vite build && electron .",
    "build": "vite build",
    "dist": "vite build && electron-builder --dir",
    "dist:installer": "vite build && electron-builder"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.2",
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.55.1",
    "reactflow": "^11.11.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tgbotbuilder.app",
    "productName": "TG Bot Builder",
    "files": [
      "dist/**/*",
      "src/main.js",
      "src/preload.js",
      "src/devtools/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "certificateFile": null,
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
